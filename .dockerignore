# Python
venv/
**/__pycache__/
**/*.pyc
.pytest_cache/

# Node / frontend build artifacts (rebuilt inside the image)
frontend/node_modules/
frontend/dist/

# Secrets & local data (never bake into the image)
.env
.env.*
frontend/.env
frontend/.env.*
*.db

# Repo noise not needed at runtime
.git/
.gitignore
tests/
eval/
*.md
design-system/
